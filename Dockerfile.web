# Runner-only image — requires a pre-built Next.js standalone bundle on the host.
# Run before building: npm run build
# (Produces .next/standalone via output: 'standalone' in next.config.js)
#
# Mac `next build` traces Darwin @img/sharp-* into that bundle. dlopen of the
# Mach-O sharp.node in this Linux container is SIGSEGV (exit 139) and Cloudflare
# 522 while Docker restarts reloadsol-web. Install the lockfile sharp build for
# linux-x64 glibc after the copy and drop any Darwin binaries.

FROM node:20-slim AS runner
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends wget \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Cached layer: exact sharp version from the lockfile (package.json is ^0.35.3).
COPY package.json package-lock.json /tmp/sharp-pin/
RUN set -eu \
  && SHARP_VERSION="$(node -e 'const lock=require("/tmp/sharp-pin/package-lock.json"); const v=lock.packages&&lock.packages["node_modules/sharp"]&&lock.packages["node_modules/sharp"].version; if(!v){process.exit(1)} process.stdout.write(String(v))')" \
  && mkdir -p /opt/sharp-linux \
  && npm install --prefix /opt/sharp-linux --no-package-lock --os=linux --cpu=x64 --libc=glibc "sharp@${SHARP_VERSION}" \
  && find /opt/sharp-linux/node_modules/@img/sharp-linux-x64 -name '*.node' | grep -q . \
  && rm -rf /tmp/sharp-pin /root/.npm

COPY public ./public
COPY .next/standalone ./
COPY .next/static ./.next/static
RUN set -eu \
  && mkdir -p /app/node_modules \
  && cp -a /opt/sharp-linux/node_modules/. /app/node_modules/ \
  && find /app/node_modules -type d \( -name 'sharp-darwin-arm64' -o -name 'sharp-darwin-x64' -o -name 'sharp-libvips-darwin-arm64' -o -name 'sharp-libvips-darwin-x64' \) -print0 | xargs -0 -r rm -rf \
  && find /app/node_modules/@img/sharp-linux-x64 -name '*.node' | grep -q . \
  && if find /app/node_modules -type d \( -name 'sharp-darwin-arm64' -o -name 'sharp-darwin-x64' -o -name 'sharp-libvips-darwin-arm64' -o -name 'sharp-libvips-darwin-x64' \) | grep -q .; then \
       echo "Darwin sharp binaries remain in the image" >&2; \
       exit 1; \
     fi \
  && chown -R nextjs:nodejs /app

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD wget --no-verbose --tries=1 -O /dev/null http://127.0.0.1:3000/api/health || exit 1

CMD ["node", "server.js"]
