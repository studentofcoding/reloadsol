{
  "name": "gmgn-web-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "account_id": "216ae9a05b5bb26a60bb06fe59525f2a",
  // Pin entry Worker near US West when possible. The Durable Object below is the
  // hard guarantee: gmgn WAF 403s CF SIN egress (Tencent SG VPS + Workers in SIN).
  "placement": {
    "region": "aws:us-west-2"
  },
  "durable_objects": {
    "bindings": [
      { "name": "GMGN_FETCHER", "class_name": "GmgnFetcher" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GmgnFetcher"] }
  ]
}
