# Copy to .env before running: cp .env.docker.example .env
# Used by docker compose for both web and cron services.
#
# Quick start:
#   cp .env.docker.example .env   # fill secrets
#   npm run docker:up             # local prod-like (web :3000, cron :8080)
#   npm run docker:dev            # hot reload dev mode
#   npm run docker:prod           # detached production

# --- Ports (host mapping) ---
# Do not leave WEB_PORT= or CRON_PORT= blank — run: bash scripts/sanitize-env-ports.sh
# Local compose (docker-compose.yml): WEB_PORT=3000, CRON_PORT=8080
# Prod overlay (docker-compose.prod.yml): fixed host ports 80 via nginx, 127.0.0.1:8080 (cron)
# CRON_PORT below is for curl/smoke only — prod compose always binds cron to 127.0.0.1:8080
WEB_PORT=3000
CRON_PORT=8080
TZ=Asia/Bangkok
# Display timezone for formatted timestamps is fixed in code (Asia/Bangkok).
# DB timestamps store UTC ISO strings only.

# --- Pattern ML (24h mcap+social cohort model — optional) ---
# Train on host: npm run ml:export-patterns && npm run ml:train-pattern
# docker-compose mounts ./ml/artifacts → /app/ml/artifacts in web container
ML_PATTERN_MODE=shadow
ML_PATTERN_P_WINNER_MIN=0.5
ML_PATTERN_ARTIFACT_DIR=/app/ml/artifacts/pattern-gate
# Phase 4 closed-loop + eval engine (all off until a model artifact exists)
# ML_CLOSED_LOOP=1
# ML_CLOSED_LOOP_ARTIFACT=/app/data/ml-closed-loop/model.json
# EVAL_ENGINE=1
# EVAL_SHADOW=1
# EVAL_EXEC_MODE=paper
# LIVE_TRADE_ENABLED=0
# ML_PAPER_MIN_COMBINED=0.35
# ML_PAPER_MIN_ML=0.5
# Early Enter toast+Telegram soft gate (default on). Does not change paper/sim-open.
# EARLY_ENTER_ML_SOFT_GATE=1
# EARLY_ENTER_ML_MIN=0.55
# Jev Noul shadow beside Early Enter (SPEC-jev-soft-gate-shadow-v1). Soft-active default OFF.
# EARLY_ENTER_NOUL_SHADOW=1
# EARLY_ENTER_NOUL_SOFT_ACTIVE=0
# EARLY_ENTER_NOUL_NO=0.2
# EARLY_ENTER_NOUL_YES=0.8
# EARLY_ENTER_NOUL_KILL_SWITCH=0
# Ops #56 — TypeSafe creds live on VPS; missing → api_miss soft-fail (do not commit secrets).
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# TYPESAFE_DEFAULT_MODEL=jev-latest
# Existing sim-outcome gate (optional — same mount root):
# ML_GATE_ARTIFACT_DIR=/app/ml/artifacts/v2-gate
# ML_POTENTIAL_ARTIFACT_DIR=/app/ml/artifacts/v2-potential
# ML2 Potential → TP/SL overlay (sim only). Default shadow = counterfactual log + audit fields.
# Flip to apply only after reviewing ml_exit_* / [ml-potential-exit:counterfactual] logs.
ML_POTENTIAL_EXIT_MODE=shadow
# ML_POTENTIAL_EXIT_MODE=apply
# ML_POTENTIAL_EXIT_MODE=off
# Optional dry-run train floor (default 30). Values <30 warn but still train.
# ML_POTENTIAL_MIN_ROWS=15

# --- Postgres (replaces hosted Supabase) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reloadsol_db
# App connects via PgBouncer (transaction pool). Used by reloadsol-web as-is (not rebuilt by compose).
# If POSTGRES_PASSWORD contains @ # : or %, URL-encode it in DATABASE_URL:
#   node -e "console.log(encodeURIComponent('your-password'))"
# Example: postgresql://postgres:pa%40ss%23word@reloadsol-bouncer:5432/reloadsol_db
DATABASE_URL=postgresql://postgres:change-me@reloadsol-bouncer:5432/reloadsol_db
# Direct URL for psql on host (127.0.0.1 with migrate overlay)
DATABASE_URL_DIRECT=postgresql://postgres:change-me@reloadsol-db:5432/reloadsol_db
# Bootstrap schema from codebase (no Supabase): bash scripts/deploy-tencent.sh schema
# Applies db/init/*.sql idempotently — empty DB, app fills data as cron/web run
# --- Memory / swap tuning (see docs; applied by sudo bash scripts/ensure-swap.sh) ---
# V8 old-space cap for reloadsol-web (default below; web idles ~130MB)
# WEB_NODE_OPTIONS=--max-old-space-size=512
# Host swap policy written to /etc/sysctl.d/99-reloadsol-memory.conf
# SWAPPINESS=10
# VFS_CACHE_PRESSURE=50
# Optional Supabase pgcopydb migrate (export in shell only):
# export SOURCE_DATABASE_URL='postgresql://postgres.[ref]:PASS@db.[ref].supabase.co:5432/postgres'
# export USE_PGCOPYDB_DOCKER=1 && bash scripts/deploy-tencent.sh migrate
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Redis (shared server cache; optional for local npm run dev) ---
REDIS_URL=redis://redis:6379/0

# --- Development wallet ---
NEXT_PUBLIC_DEV_WALLETS=3V3N5xh6vUUVU3CnbjMAXoyXendfXzXYKzTVEsFrLkgX

# --- Robinhood network allowlist (Sol and/or EVM, comma-separated) ---
# Union with DEV wallets: either list unlocks Sol/RH toggle. Dev routes still need DEV list.
NEXT_PUBLIC_RH_WHITELIST=
# RH_WHITELIST= # optional server alias (same comma-separated format)

# --- Solana RPC (up to 5 comma-separated URLs) — https://shyft.to dashboard ---
# SHYFT_API_KEY powers REST wallet API (api.shyft.to) + send_many_txns / send_txn.
# Sell/buy holdings: cached Shyft /sol/v1/wallet/all_tokens (15s fresh / 120s stale;
# pass ?fresh=1 after a confirmed trade). Jupiter portfolio is fallback.
# Quotes/swaps stay on Solana Tracker Raptor — do not point TRADE RPC at Shyft.
# Shyft free plan blocks index RPC methods — add a fallback URL for close-only empty ATAs:
# RPC_URL=https://rpc.shyft.to?api_key=KEY,https://api.mainnet-beta.solana.com
# --- Trade/RPC stack ---
# Default stack is 'raptor': quotes stay on raptor-beta.solanatracker.io, but
# transaction send/confirm goes to the Solana Tracker RPC below (rpc-mainnet).
# Set TRADE_PROVIDER=shyft to send via Shyft send_txn instead.
# TRADE_PROVIDER=raptor
# Primary Solana Tracker RPC (docs: https://docs.solanatracker.io — api_key as query param):
# SOLANATRACKER_RPC_URL=https://rpc-mainnet.solanatracker.io/?api_key=YOUR_SOLANATRACKER_API_KEY
# WebSocket variant of the same RPC (signatureSubscribe / accountSubscribe confirms):
# NEXT_PUBLIC_SOLANA_WS_URL=wss://rpc-mainnet.solanatracker.io/?api_key=YOUR_SOLANATRACKER_API_KEY
# Solana JSON-RPC rate limit (Solana Tracker internal = 5 req/s).
# Measured 2026-10-01: it REJECTS bursts instead of queueing (6 posted at once -> 0 ok, 6 x429;
# the same 6 spaced 250ms -> 6/6). Concurrency does not raise throughput, only the 429 count.
# JSON-RPC batch is capped at 10 but counted per call, so it buys nothing — batch ACCOUNT reads
# with getMultipleAccounts (up to 100 keys per call) instead.
# Full table: docs/05-operations-and-deployment.md § "Measured RPC capacity".
RPC_MAX_REQ_PER_SEC=5
# Chunk size for bulk prepare/sign. Multi-tx broadcast uses Shyft send_many_txns
# (one REST call per chunk); per-tx Tracker RPC is the fallback.
TRADE_SEND_CONCURRENCY=4
SHYFT_API_KEY=your-shyft-api-key
# Max Shyft REST calls/sec (wallet poll, all_tokens). Default 5.
SHYFT_MAX_REQ_PER_SEC=5
# Shyft JSON-RPC — used for the BATCH swap landing ONLY; single swaps keep the lanes above.
# Measured 2026-10-02 on a real 5-leg batch: send_many_txns gave 417 / 1 of 3 landed / 61s confirm,
# while this RPC paced gave 3 of 3 / 163ms confirm. Unset = previous behaviour, unchanged.
SHYFT_RPC_URL=https://rpc.shyft.to?api_key=your-shyft-api-key
# Serial spacing between batch sends, ms. Parallel sends drew RateLimitExceeded at three. Default 400.
BATCH_SEND_MIN_INTERVAL_MS=400
RPC_URL=https://rpc.shyft.to?api_key=your-shyft-api-key,https://api.mainnet-beta.solana.com
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com

# --- Solana Tracker Raptor swap API (optional override) ---
# RAPTOR_API_BASE=https://raptor-beta.solanatracker.io
# Hop ceiling for a route touching SOL / USDC / USDT — those have a direct pool, so 1 is correct.
# Do NOT raise this to fix a token->token quote: use RAPTOR_TOKEN_TOKEN_HOPS below. A single global
# value cannot serve both, and at 1 a token->token pair returns
# `500 "No direct route found and maxHops=1"`, which then escalated to the Jupiter picker and spent
# the 0.5 rps execution budget. Resolved per-pair by src/utils/raptor-hops.ts.
# RAPTOR_MAX_HOPS=1
# Hops for a token->token pair (neither side verified). 2 routes the pairs we measured; 3 adds headroom.
# Set to 1 to restore the old behaviour exactly.
# RAPTOR_TOKEN_TOKEN_HOPS=3
# RAPTOR_MAX_HOPS_ARBITRAGE=3  # arb-only; does not change directional bots
# Directional quote pick: discard routes whose abs price impact exceeds this % (default 15).
# SWAP_QUOTE_MAX_IMPACT_PCT=15
# Token-2022 transfer fees: never quote slippage below the mint's own fee + this margin (default 30).
# A fee larger than the slippage budget makes the router's post-check fail with 6001 on every build.
# SWAP_TRANSFER_FEE_MARGIN_BPS=30
# How long a mint's transfer-fee schedule is cached, ms (default 600000).
# SWAP_TRANSFER_FEE_CACHE_MS=600000
# Priority fee used when a caller passes none. Unset = auto-high (a 0.003 SOL cap, not a flat charge).
# A transaction broadcast with no tip is how one lands nowhere; a caller-supplied fee always wins.
# SWAP_PRIORITY_FEE_LAMPORTS=150000

# Jupiter Price V3 (server-only). Recreate web/cron after adding so the container sees it.
# Never expose this to the browser. Lite-api is rate-limited from the VPS.
# JUPITER_API_KEY=
# Rate control (src/utils/jupiter-rps.ts): one token bucket + priority lanes. The quota is
# burst-shaped — paced 0.5 rps measured 10/10 clean, "~6 rps sequential" was 8 ok then 429, and any
# sustained concurrency is rejected outright — so the sustained rate stays and only the burst is new.
# JUPITER_MAX_RPS=0.5          # sustained refill rate
# JUPITER_BURST=8              # bucket capacity; a bulk batch of prepares fits one burst
# JUPITER_TRADE_RESERVE=2      # held for the trade lane (taker prepare, /execute, Lite /swap build)
# JUPITER_QUOTE_CACHE_MS=4000  # coalesce/cache non-taker quotes; taker-scoped calls are never cached
# Token metadata/market-hints queue (src/utils/jupiter-metadata.ts, docs/JUPITER_API_MAP.md): cache ->
# ONE paced, batched KEYLESS api.jup.ag/tokens/v2/search queue -> keyed api.jup.ag only on a keyless 429.
# Keyless ceiling is 0.5 rps (30/min) per client in a bucket of its own; stay under it.
# JUPITER_META_RPS=0.3                  # sustained keyless request rate (each request carries up to 100 mints)
# JUPITER_META_BURST=2                  # keyless bucket size
# JUPITER_META_NEGATIVE_TTL_MS=90000    # how long "Jupiter has no such token" is remembered
# JUPITER_META_KEYLESS=1                # 0 = skip the keyless lane, use the key only
# JUPITER_META_DB_CACHE=1               # 0 = no Postgres L2 (jupiter_token_meta)
# Execution cost model (src/strategies/execution-model.ts). Defaults are measured, not round numbers:
# a live pair round-tripped ~26 bps (~12 bps/side, the AMM fee), the app sends 30,000 lamports of
# priority fee, and the chain's recent ask is ~0. These decide whether a paper edge is real.
# SIM_FEE_BPS=12
# SIM_SPREAD_BPS=0
# SIM_PRIORITY_FEE_QUOTE=0.00003

# --- SOL triangular arbitration (SOL→A→B→SOL) ---
# SOL_ARB_PAIRS=[{"mintA":"...","mintB":"...","label":"CRX/SCX"}]
# SOL_ARB_AMOUNT_LAMPORTS=100000000
# SOL_ARB_SLIPPAGE_BPS=300
# SOL_ARB_MIN_EDGE_LAMPORTS=0
# SOL_ARB_SCAN_SECRET=   # defaults to TRENDING_TRACKER_SECRET
# SOL_ARB_SCAN_INTERVAL=60  # cron seconds; 0 disables

# RobinhoodTrenches (fomo.family) fill mirror — research-grade WS
FOMO_WS_ENABLED=true
FOMO_WS_URL=wss://robinhoodtrenches.com/ws
FOMO_REST_BASE=https://robinhoodtrenches.com
FOMO_WS_KEEPALIVE_MS=20000
FOMO_WS_RECONNECT_MS=2500
FOMO_MAX_FILLS_PER_BATCH=100
FOMO_LAG_ALERT_SECONDS=30
# SOL_ARB_LIVE_ENABLED=false  # server-side execute / execute-atomic live

# --- Solana Tracker Data API (OHLCV: GET {origin}/chart/{token}) ---
# Origin only (scheme + host). A trailing /chart or api_key query is ignored.
# Unset uses the dedicated secure host. That host authenticates by subdomain
# and returns 400 if x-api-key or api_key is sent — leave the key unset for it.
# SOLANATRACKER_DATA_API_BASE=https://ivory-badger-5278.secure.data.solanatracker.io
# Alias for the same origin (SOLANATRACKER_CHART_BASE wins when both are set):
# SOLANATRACKER_CHART_BASE=
# Public https://data.solanatracker.io works only when set as the base above.
# On that host only, send the key as a header (never on *.secure.data.solanatracker.io):
# SOLANATRACKER_DATA_API_KEY=
# Process-wide Solana Tracker OHLC start rate (shared by live charts and refill
# workers in the same Node process). Default 3. Concurrency does not raise this.
# SOLANATRACKER_OHLC_RPS=3
# Parallel workers for scripts/backfill-mcap-labels.ts / mcap-ohlc-refill-daemon.sh.
# Default 3. HTTP starts stay on SOLANATRACKER_OHLC_RPS.
# MCAP_OHLC_CONCURRENCY=3
# Daemon (Sol only, last 7 days, does not start EVM): bash scripts/mcap-ohlc-refill-daemon.sh

# --- Trade provider stack (server/cron default: shyft) ---
# shyft  = Shyft RPC + Shyft send_txn; Raptor quote build with Jupiter Lite fallback (default)
# raptor = Solana Tracker RPC + Raptor quote/send/confirm — set TRADE_PROVIDER=raptor to use
# TRADE_PROVIDER=raptor
# SHYFT_API_KEY required for shyft stack (default)

# --- Trading bot keypair (JSON array) — required for live trades + DLMM ---
# TRADING_KEYPAIR_JSON=[1,2,3,...]

# --- MCap tracker live Raptor (mcap_enter_first_seen only) ---
# MCAP_LIVE_TRADING_ENABLED=false
# Must be true + TRADING_KEYPAIR_JSON + strategy execution_mode=live_only for cron live buys
# MCAP_TRACKER_LIVE_WALLET=  # optional; defaults to keypair pubkey
# Host CLI: npm run mcap:raptor-trade -- --mint=<CA> --sol=0.01 --quote-only

# --- Bot automation (real trading circuit breaker + duplicate-buy locks) ---
# Failures counted on consecutive real buy errors; auto-resumes after HALT minutes.
BOT_TRADING_FAILURE_THRESHOLD=3
BOT_TRADING_HALT_MINUTES=20
BOT_TRADE_LOCK_TTL_SEC=120
# Optional — only used when acquireJobLock() omits per-job TTL (defaults to 600)
# BOT_JOB_LOCK_TTL_SEC=600

# --- Cron secrets ---
TRENDING_TRACKER_SECRET=r3l0ads0l-trending
# Track strategy: skip the filtering-summary Discord alerts (default true; false re-enables them)
TRENDING_LIST_DISCORD_VIA_CRON=true
# REMOVED (list-style trending Discord notifications were deleted): AUTO_NOTIFICATION_INTERVAL_MS,
# FILTERED_AUTO_NOTIFICATION_INTERVAL_MS — safe to delete from existing .env files.
PNL_UPDATE_SECRET=r3l0ads0l-pnl
# Alias accepted by /api/pnl/update: PNL_UPDATE_TOKEN (same value as PNL_UPDATE_SECRET)
DLMM_SCREEN_SECRET=r3l0ads0l-trending
DLMM_MANAGE_SECRET=r3l0ads0l-trending

# --- Goldsky RH wallet ledger (see GOLDSKY_RH_LEDGER.md) ---
# Bearer token the Goldsky Turbo webhook sink sends to POST /api/rh/ledger/ingest.
# MUST match the `httpauth` Goldsky secret RH_LEDGER_WEBHOOK_SECRET.
RH_LEDGER_WEBHOOK_SECRET=change-me
# Optional Rabby parent wallet to include in the ledger (the GMGN bound EVM
# wallet is read from GMGN_BOUND_EVM_ADDRESS). Only used for env-seeding the
# tracked_rh_wallets table — the pipeline YAML holds the real filter list.
# RH_TRACKED_PARENT_ADDRESS=0x...
# RH parent batches: expose the BatchExecutor to the BROWSER (NEXT_PUBLIC_*) so
# Rabby parent buys/sells use the atomic executor path (one executeBatch tx +
# approvals only when missing) instead of per-leg approve+swap prompts.
# NEXT_PUBLIC_RH_BATCH_EXECUTOR_ADDRESS=0x...
# NEXT_PUBLIC_RH_PERMIT2_SWAPS=1
# Minimum USD a confirmed holding must be worth to stay in the RH token list;
# confirmed sub-floor holdings are dust-blacklisted for 24h (skipped cheaply).
# Unpriced tokens are never dropped by this.
# RH_MIN_HOLDING_USD=0.01

# --- DLMM agent ---
DLMM_AGENT_ENABLED=true
DLMM_DRY_RUN=true
DLMM_API_PASSWORD=earlytrencher
DLMM_SCREEN_INTERVAL=300
DLMM_SIM_TRACK_INTERVAL=300
DLMM_MANAGE_INTERVAL=60
# Optional S5 paper climate gate (default off). Ask before live force.
# Docs: docs/CLIMATE_GATE.md — kill/daily-loss/capital caps always win.
# CLIMATE_GATE=1
# CLIMATE_GATE_LIVE=1
# CLIMATE_FAIL_CLOSED=1
# CLIMATE_URL=https://terminal.reloadsol.app/api/regime/climate
# Optional market-brain read client (lists + recipes + /regime/params + /ohlc + /risk/from-score).
# Universe plugs default off. OHLC prefers GET /ohlc when MARKET_BRAIN_TOKEN is set
# (set MARKET_BRAIN_OHLC=0 to keep SolanaTracker/GMGN). Sim-open climate size still
# uses /regime/params (then recipe.riskGrid) when MARKET_BRAIN_TOKEN is set —
# independent of the membership flags below. Principal score→TP/SL defaults on
# (set MARKET_BRAIN_SCORE_RISK=0 to keep DEFAULT_MCAP_TRACKER_EXIT / recipe risk).
# MARKET_BRAIN_URL=https://market-brain.yonathanevanchristy.workers.dev
# MARKET_BRAIN_TOKEN=   # Bearer = BRAIN_READ_TOKEN; never commit a real token
# MARKET_BRAIN_READ_TOKEN=  # alias for MARKET_BRAIN_TOKEN
# MARKET_BRAIN_ADMIN_TOKEN=   # Bearer = BRAIN_ADMIN_TOKEN; recipe writes (promote/deactivate/dormant/tidy/seed). Never commit.
# MARKET_BRAIN_TRENDING=1  # opt-in: trending assign membership from GET /union
# MARKET_BRAIN_MCAP=1      # opt-in: mcap sim-track membership + default gates from GET /union
# MARKET_BRAIN_SIGNALS=1   # opt-in: signals sim-track membership + default gates from GET /union
# MARKET_BRAIN_OHLC=0      # opt-out: force today's ST/GMGN OHLC (default on when token set)
# MARKET_BRAIN_SCORE_RISK=0 # opt-out: skip GET /risk/from-score on principal sim-open
# Optional data-public observe BFF override (no secrets). Docs: docs/DATA_PUBLIC_SCOUT.md
# DATA_PUBLIC_FEED_URL=https://data-public.vercel.app/api/feed
# Robinhood tab → LP Terminal (chainId 4663). Client deep links need NEXT_PUBLIC_*.
NEXT_PUBLIC_LP_TERMINAL_BASE_URL=https://lp-terminal.xyz
# Indexer for the Robinhood Pools table + the rh_lp_screen paper job. There is NO live public
# default: lp-terminal.xyz answers HTTP 410 on /api/lp/*, and the code fallback robinhoodpools.lol is
# NXDOMAIN (since 2026-09-07). Set this to a live/self-hosted indexer BEFORE re-enabling rh_lp_screen.
# LP_TERMINAL_INDEXER_URL=http://127.0.0.1:8787
# rh_lp_screen (paper-only RH LP screen, cron job). 0 = disabled (matches production since 2026-10-04);
# code default is 300. Needs a live LP_TERMINAL_INDEXER_URL above, else it fails every cycle.
RH_LP_SCREEN_INTERVAL=0
# Robinhood RPC for RH V2 LP marks (server) / optional client reads
