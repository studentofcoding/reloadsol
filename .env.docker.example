# Shadow risk — dev reputation + keyless RugCheck. Display-only: records and
# labels, gates nothing. Keep DEV_REPUTATION_MODE=shadow until the correlation
# is significant (docs/specs/SPEC-dev-reputation-rugcheck-v1.md).
# RUGCHECK_ENABLED=false
# RUGCHECK_MAX_REQ_PER_SEC=3
# RUGCHECK_TTL_S=900
# DEV_REPUTATION_ENABLED=false
# DEV_REPUTATION_MODE=shadow
# DEV_REPUTATION_KILL_SWITCH=false
# DEV_REPUTATION_TTL_S=86400
# DEV_MIN_SAMPLE=5
# DEV_BAN_MAX_GRADUATION=0.05
# DEV_GOOD_MIN_GRADUATION=0.25
# DEV_GOOD_MIN_ATH_MC=1000000
