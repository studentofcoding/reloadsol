# Copy to .env before running: cp .env.docker.example .env
# Used by docker compose for both web and cron services.
#
# Quick start:
#   cp .env.docker.example .env   # fill secrets
#   npm run docker:up             # local prod-like (web :3000, cron :8080)
#   npm run docker:dev            # hot reload dev mode
#   npm run docker:prod           # detached production

# --- Ports (host mapping) ---
WEB_PORT=3000
CRON_PORT=8080
TZ=Asia/Bangkok

# --- Supabase (required for DLMM positions, config, trading history) ---
# Get these from: Supabase Dashboard → Project Settings → API
# The project ref must resolve via DNS (ENOTFOUND = wrong/deleted project URL).
SUPABASE_URL=https://dipfxpcqudmfsdyacgdl.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRpcGZ4cGNxdWRtZnNkeWFjZ2RsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDAzOTAxODAsImV4cCI6MjA1NTk2NjE4MH0.gW8AlAPnQBFpEoO3fK2NP8ojS3H1yKJ-wk8lP_7Z8Yo
NEXT_PUBLIC_SUPABASE_URL=https://dipfxpcqudmfsdyacgdl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRpcGZ4cGNxdWRtZnNkeWFjZ2RsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDAzOTAxODAsImV4cCI6MjA1NTk2NjE4MH0.gW8AlAPnQBFpEoO3fK2NP8ojS3H1yKJ-wk8lP_7Z8Yo
# After setting credentials, run supabase/schema.sql in the SQL editor.

# --- Development wallet ---
NEXT_PUBLIC_DEV_WALLETS=3V3N5xh6vUUVU3CnbjMAXoyXendfXzXYKzTVEsFrLkgX

# --- Solana RPC (Shyft) — https://shyft.to dashboard ---
SHYFT_API_KEY=your-shyft-api-key
RPC_URL=https://rpc.shyft.to?api_key=your-shyft-api-key
NEXT_PUBLIC_RPC_URL=https://rpc.shyft.to?api_key=your-shyft-api-key

# --- Trading bot keypair (JSON array) — required for live DLMM ---
# TRADING_KEYPAIR_JSON=[1,2,3,...]

# --- Cron secrets ---
TRENDING_TRACKER_SECRET=r3l0ads0l-trending
PNL_UPDATE_SECRET=r3l0ads0l-pnl
DLMM_SCREEN_SECRET=r3l0ads0l-trending
DLMM_MANAGE_SECRET=r3l0ads0l-trending

# --- DLMM agent ---
DLMM_AGENT_ENABLED=false
DLMM_DRY_RUN=true
DLMM_API_PASSWORD=earlytrencher
DLMM_SCREEN_INTERVAL=300
DLMM_MANAGE_INTERVAL=60

# --- Telegram (DLMM alerts + bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=reloadsol-dlmm-secret
# After deploy: npm run dlmm:telegram-webhook -- https://your-domain/api/dlmm/telegram

# --- Discord (optional — cron operational logs) ---
# DISCORD_WEBHOOK_URL=

# --- Dev wallets (comma-separated; shows extra nav tabs for these addresses) ---
# NEXT_PUBLIC_DEV_WALLETS=YourWallet1,YourWallet2

# --- App URLs ---
NEXT_PUBLIC_API_HOST=http://localhost:3000
API_HOST=http://web:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Wallet API session (required for History/PnL trading records) ---
# Generate: openssl rand -hex 32
WALLET_SESSION_SECRET=generate-with-openssl-rand-hex-32
WALLET_SESSION_TTL_HOURS=168
