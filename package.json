{
  "name": "solana-bulk-buy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "sh scripts/next-dev.sh",
    "dev:webpack": "sh scripts/next-dev.sh --webpack",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "build:analyze": "ANALYZE=true next build:webpack",
    "start": "next start",
    "start:prod": "NODE_ENV=production next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "smoke:gmgn-live-boost": "npx tsx scripts/smoke-gmgn-live-boost.ts",
    "prebuild": "node scripts/prebuild-strip-local-venvs.js",
    "postbuild": "node scripts/lock-next-env.js",
    "ml:backfill-labels": "npx tsx scripts/backfill-ml-labels.ts",
    "mcap:raptor-trade": "npx tsx scripts/mcap-raptor-trade.ts",
    "mcap:strategy-search": "npx tsx scripts/mcap-strategy-search.ts",
    "mcap:strategy-search:optuna": "cd ml && python3 mcap_strategy_search_optuna.py",
    "mcap:strategy-bandit": "npx tsx scripts/mcap-strategy-bandit.ts",
    "ml:export-entry-features": "sh -c 'test -n \"$TRENDING_TRACKER_SECRET\" || { echo \"[ERROR] TRENDING_TRACKER_SECRET is not set\"; exit 1; }; cd ml && python3 export_training_data.py --features v1 --domain mcap_tracker'",
    "ml:export-v1-features": "npm run ml:export-entry-features",
    "ml:export-v2-social-experimental": "sh -c 'test -n \"$TRENDING_TRACKER_SECRET\" || { echo \"[ERROR] TRENDING_TRACKER_SECRET is not set\"; exit 1; }; cd ml && python3 export_training_data.py --features v2 --output data/v2/training_experimental.parquet --domain mcap_tracker'",
    "ml:export": "npm run ml:export-entry-features",
    "ml:train-gate": "cd ml && python3 train.py --stage gate --input data/v2/training.parquet --version v2-gate",
    "ml:train-potential": "cd ml && python3 train.py --stage potential --input data/v2/training.parquet --version v2-potential",
    "ml:check-dataset": "cd ml && python3 check_dataset.py data/v2/training.parquet --meta artifacts/v2-gate/model.meta.json --stage gate",
    "ml:check-potential": "cd ml && python3 check_dataset.py data/v2/training.parquet --meta artifacts/v2-potential/model.meta.json --stage potential",
    "ml:export-patterns": "sh -c 'test -n \"$TRENDING_TRACKER_SECRET\" || { echo \"[ERROR] TRENDING_TRACKER_SECRET is not set\"; exit 1; }; cd ml && python3 export_pattern_data.py --output data/pattern/training.parquet'",
    "ml:train-pattern": "cd ml && python3 train_pattern.py --input data/pattern/training.parquet --version pattern-gate",
    "ml:check-pattern": "cd ml && python3 check_pattern_dataset.py data/pattern/training.parquet --meta artifacts/pattern-gate/model.meta.json",
    "ml:pattern-daily": "bash scripts/ml-pattern-daily.sh",
    "test:watch": "vitest",
    "verify:no-raw-useeffect": "node scripts/verify-no-raw-useeffect.js",
    "logs": "node scripts/tail-logs.js",
    "logs:follow": "node scripts/tail-logs.js -f",
    "logs:errors": "node scripts/tail-logs.js -l error",
    "logs:trending": "node scripts/tail-logs.js -e /api/trending",
    "logs:stats": "node scripts/tail-logs.js -s",
    "clean": "rm -rf .next out",
    "clean:all": "rm -rf .next out node_modules && npm install",
    "test:api": "node scripts/test-api.js",
    "dlmm:telegram-webhook": "node scripts/setup-telegram-webhook.js",
    "docker:up": "bash scripts/docker-up.sh",
    "docker:up:web": "bash scripts/docker-up.sh prod web",
    "docker:up:cron": "bash scripts/docker-up.sh prod cron",
    "docker:dev": "bash scripts/docker-up.sh dev",
    "docker:dev:full": "bash scripts/docker-up.sh dev-full",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:prod": "bash scripts/docker-up.sh prod-daemon",
    "docker:deploy": "bash scripts/docker-deploy.sh --auto",
    "docker:deploy:web": "bash scripts/docker-deploy.sh --web-only",
    "docker:deploy:cron": "bash scripts/docker-deploy.sh --cron-only",
    "docker:deploy:all": "bash scripts/docker-deploy.sh --all",
    "docker:deploy:social": "bash scripts/docker-deploy.sh --social-only",
    "docker:deploy:hook": "bash scripts/install-docker-deploy-hook.sh",
    "lockfile:sync": "bash scripts/npm-ci-sync.sh --fix-lockfile",
    "install:ci": "bash scripts/npm-ci-sync.sh",
    "rebuild:native": "bash scripts/rebuild-native-deps.sh",
    "postinstall": "bash scripts/rebuild-native-deps.sh",
    "social:seed-wallets": "npx tsx scripts/seed-tracked-wallets.ts",
    "docker:social": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build social-ingest",
    "deploy:tencent": "bash scripts/deploy-tencent.sh",
    "social:bootstrap": "bash scripts/bootstrap-social-server.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@jup-ag/wallet-adapter": "^0.2.6",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "^1.2.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.2.0",
    "@meteora-ag/dlmm": "^1.9.10",
    "@solana/spl-token": "^0.3.11",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.81.2",
    "@vercel/analytics": "^1.5.0",
    "assert": "^2.0.0",
    "autoprefixer": "^10.0.1",
    "browserify-zlib": "^0.2.0",
    "bs58": "^6.0.0",
    "chart.js": "^4.5.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "crypto-browserify": "^3.12.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "events": "^3.3.0",
    "https-browserify": "^1.0.0",
    "ioredis": "^5.11.1",
    "lightweight-charts": "^5.2.0",
    "next": "16.2.9",
    "onnxruntime-node": "^1.27.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "pg": "^8.22.0",
    "postcss": "^8.5.15",
    "puppeteer": "^24.37.3",
    "react": "19",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19",
    "react-icons": "^5.5.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "tailwindcss": "^3.3.0",
    "tweetnacl": "^1.0.3",
    "url": "^0.11.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "typescript": "^5.0.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=8.0.0"
  },
  "overrides": {
    "bigint-buffer": "npm:bigint-buffer-fixed@1.1.6",
    "uuid": "^11.1.1",
    "next": {
      "postcss": "8.5.15"
    }
  }
}
