# Host-local VPS state — never commit, and keep out of `git clean -fd`:
# nginx/certs holds the origin TLS key that the :443 vhost mounts, cloudflared/
# holds tunnel credentials, and the htpasswd file gates the flowey admin vhost.
nginx/certs/
nginx/conf.d/.htpasswd-*
cloudflared/
.env.bak.*
